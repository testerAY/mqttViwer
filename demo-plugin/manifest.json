{
    "id": "demo-widget",
    "name": "Demo Widget",
    "version": "1.0.0",
    "main": "index.js",
    "tagName": "demo-widget",
    "description": "A sample widget plugin",
    "capabilities": {
        "requiresTopic": true
    },
    "configSchema": [
        {
            "name": "headerText",
            "label": "Header Text",
            "type": "text",
            "defaultValue": "Demo Widget"
        },
        {
            "name": "fontSize",
            "label": "Font Size (px)",
            "type": "number",
            "defaultValue": 16,
            "min": 8,
            "max": 72
        },
        {
            "name": "showBorder",
            "label": "Show Border",
            "type": "checkbox",
            "defaultValue": true
        }
    ]
}